{
  "name": "dsh-delegation-router",
  "version": "0.12.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CainDez/dsh-delegation-router.git"
  },
  "homepage": "https://github.com/CainDez/dsh-delegation-router#readme",
  "bugs": {
    "url": "https://github.com/CainDez/dsh-delegation-router/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "subagent",
    "delegation",
    "model-routing"
  ],
  "description": "DSH execution profiles with exact provider/model/effort, AI-generated configuration drafts, explicit validated apply and manual editing; preserves host authorization and the parent model.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15",
    "dsh": "0.2.2-rc.3 || >=0.2.2-rc.5 <0.2.2"
  },
  "exports": {
    ".": "./src/plugin.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "examples/candidates.json",
    "locale",
    "assets",
    "cordis.patch.yml",
    "client.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "pack": "npm pack --ignore-scripts"
  },
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "~1.9.0",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3 || >=0.2.2-rc.5 <0.2.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3 || >=0.2.2-rc.5 <0.2.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3 || >=0.2.2-rc.5 <0.2.2",
    "zod": "4.6.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cosmokit": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
